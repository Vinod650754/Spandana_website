# Application Environment
NODE_ENV=development
PORT=4000

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Supabase Database Configuration
# DATABASE_URL should use the transaction-mode pooler for normal API traffic.
# DIRECT_URL should use the session-mode pooler for migrations.
DATABASE_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres
DATABASE_SSL=auto

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
# Get these from: https://cloudinary.com/console/settings/api-keys
# Cloud Name: Your Cloudinary account cloud name
# API Key: Your Cloudinary API key
# API Secret: Your Cloudinary API secret (keep this private!)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend Configuration
# Comma-separated list of allowed frontend origins for CORS.
# Include local development and production frontend domains.
FRONTEND_URLS=http://localhost:3000,https://spandana-seven.vercel.app

# Admin Credentials (Update these immediately after first login!)
ADMIN_EMAIL=socialoutreachclubmvit@gmail.com
ADMIN_PASSWORD=Spandana@123

